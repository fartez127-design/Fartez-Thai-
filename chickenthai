-- ================= [ 4. CORE LOGIC (WALKTO & TOUCH) ] ================= --
local function WalkTo(targetPos, stopDistance)
    local char = player.Character
    if not char then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local root = char:FindFirstChild("HumanoidRootPart")
    if not hum or not root then return false end

    local stopDist = stopDistance or 1.0
    hum:MoveTo(targetPos)

    local reached = false
    local connection
    connection = hum.MoveToFinished:Connect(function()
        reached = true
    end)

    local startTime = tick()
    while not reached and (Config.AutoCollectScrap or Config.AutoCollectEggs) do
        task.wait(0.05)
        char = player.Character
        root = char and char:FindFirstChild("HumanoidRootPart")
        if not root then break end
        
        local currentDist = (root.Position - targetPos).Magnitude
        if currentDist <= stopDist then
            reached = true
            break
        end

        if tick() - startTime > 2.5 then
            hum:MoveTo(targetPos)
            startTime = tick()
        end
    end

    if connection then connection:Disconnect() end
    return reached
end

local function TouchTarget(targetPart)
    if not targetPart or not targetPart.Parent then return false end
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")

    if root and typeof(firetouchinterest) == "function" then
        pcall(function()
            firetouchinterest(root, targetPart, 0)
            task.wait(0.05)
            firetouchinterest(root, targetPart, 1)
            task.wait(0.05)
            firetouchinterest(root, targetPart, 0)
        end)
    end
end

-- ================= [ SYSTEM A: AUTO COLLECT SCRAP ] ================= --
task.spawn(function()
    while true do
        task.wait(0.2)
        if Config.AutoCollectScrap then
            local collectedCount = 0
            local targetMax = math.clamp(math.floor(Config.CollectAmount), 1, 20)
            
            if StatusLabel then 
                StatusLabel.Text = "Status: [Scrap] เป้าหมาย " .. targetMax .. " ชิ้น" 
            end

            local ignoredParts = {}

            while Config.AutoCollectScrap and collectedCount < targetMax do
                local pitScrap = Workspace:FindFirstChild("PitScrap", true)
                local char = player.Character
                local root = char and char:FindFirstChild("HumanoidRootPart")
                
                local closestPart = nil
                local minDist = math.huge

                if pitScrap and root then
                    for _, v in ipairs(pitScrap:GetDescendants()) do
                        if v:IsA("BasePart") and v.Name ~= "Terrain" and not ignoredParts[v] and not v:IsDescendantOf(char) then
                            local d = (v.Position - root.Position).Magnitude
                            if d < minDist then
                                minDist = d
                                closestPart = v
                            end
                        end
                    end
                end

                if closestPart and closestPart.Parent then
                    if StatusLabel then StatusLabel.Text = "Status: [Scrap] เก็บ (" .. (collectedCount + 1) .. "/" .. targetMax .. ")" end
                    local reached = WalkTo(closestPart.Position, 1.8)
                    if reached and Config.AutoCollectScrap then
                        TouchTarget(closestPart)
                        ignoredParts[closestPart] = true
                        collectedCount = collectedCount + 1
                        task.wait(0.1)
                    else
                        ignoredParts[closestPart] = true
                    end
                else
                    break
                end
                task.wait(0.05)
            end

            if Config.AutoCollectScrap and collectedCount > 0 and Config.SavedHomePos then
                if StatusLabel then StatusLabel.Text = "Status: [Scrap] เดินกลับบ้าน..." end
                WalkTo(Config.SavedHomePos, 2.5)
                task.wait(1)
            end
        end
    end
end)

