            if Config.SavedHomePos == nil then
                local char = player.Character
                local root = char and char:FindFirstChild("HumanoidRootPart")
                if root then Config.SavedHomePos = root.Position end
            end

            local nestFolder = Workspace:FindFirstChild("NestEggs", true) 
                or Workspace:FindFirstChild("Eggs", true) 
                or Workspace:FindFirstChild("Nests", true)

            if not nestFolder then
                for _, obj in ipairs(Workspace:GetChildren()) do
                    if obj:IsA("Folder") and (string.find(string.lower(obj.Name), "egg") or string.find(string.lower(obj.Name), "nest")) then
                        nestFolder = obj
                        break
                    end
                end
            end

            if nestFolder and Config.SavedHomePos then
                local closestEggPart = nil
                local minDistance = math.huge

                for _, v in ipairs(nestFolder:GetDescendants()) do
                    if v:IsA("BasePart") and v.Name ~= "Terrain" and v.Transparency < 1 then
                        local distFromHome = (v.Position - Config.SavedHomePos).Magnitude
                        if distFromHome <= Config.HomeZoneRadius then
                            local char = player.Character
                            local root = char and char:FindFirstChild("HumanoidRootPart")
                            local distToChar = root and (v.Position - root.Position).Magnitude or math.huge
                            
                            if distToChar < minDistance then
                                minDistance = distToChar
                                closestEggPart = v
                            end
                        end
                    end
                end

                if closestEggPart and closestEggPart.Parent then
                    if StatusLabel then StatusLabel.Text = "ถ่าเก็บไข่" end
                    local reached = WalkTo(closestEggPart.Position, 1.0)
