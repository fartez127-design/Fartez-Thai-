        local OptLabel = Instance.new("TextLabel", OptBtn)
        OptLabel.Size = UDim2.new(0.8, 0, 1, 0)
        OptLabel.Position = UDim2.new(0, 20, 0, 0)
        OptLabel.BackgroundTransparency = 1
        OptLabel.Text = tostring(optValue)
        OptLabel.TextColor3 = (optValue == defaultSelected) and Theme.Accent or Theme.TextDim
        OptLabel.TextSize = 11
        OptLabel.Font = Enum.Font.Gotham
        OptLabel.TextXAlignment = Enum.TextXAlignment.Left

        OptBtn.MouseButton1Click:Connect(function()
            SelectedLabel.Text = tostring(optValue)
            isOpen = false
            Arrow.Text = "▼"
            TweenService:Create(Container, TweenInfo.new(0.25), {Size = UDim2.new(0.9, 0, 0, 40)}):Play()
            
            for _, btn in ipairs(OptionList:GetChildren()) do
                if btn:IsA("TextButton") then
                    btn.TextLabel.TextColor3 = Theme.TextDim
                end
            end
            OptLabel.TextColor3 = Theme.Accent
            pcall(callback, optValue)
        end)
    end
end

