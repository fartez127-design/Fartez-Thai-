    Arrow.Text = "▼"
    Arrow.TextColor3 = Theme.Accent
    Arrow.TextSize = 12
    Arrow.Font = Enum.Font.GothamBold

    local OptionList = Instance.new("Frame", Container)
    OptionList.Size = UDim2.new(1, 0, 0, 0)
    OptionList.Position = UDim2.new(0, 0, 0, 40)
    OptionList.BackgroundTransparency = 1

    local ListLayout = Instance.new("UIListLayout", OptionList)
    ListLayout.SortOrder = Enum.SortOrder.LayoutOrder

    local isOpen = false
    local currentOptionsCount = 0

    Header.MouseButton1Click:Connect(function()
        isOpen = not isOpen
        Arrow.Text = isOpen and "▲" or "▼"
        local targetHeight = isOpen and (40 + currentOptionsCount * 30) or 40
        TweenService:Create(Container, TweenInfo.new(0.25), {Size = UDim2.new(0.9, 0, 0, targetHeight)}):Play()
    end)

    local function RefreshOptions(optionsList)
        for _, child in ipairs(OptionList:GetChildren()) do
            if child:IsA("TextButton") then child:Destroy() end
        end

        currentOptionsCount = #optionsList
        OptionList.Size = UDim2.new(1, 0, 0, #optionsList * 30)

        if isOpen then
            Container.Size = UDim2.new(0.9, 0, 0, 40 + #optionsList * 30)
        end

        for _, optName in ipairs(optionsList) do
            if targetTable[optName] == nil then
                targetTable[optName] = false
            end

            local OptBtn = Instance.new("TextButton", OptionList)
            OptBtn.Size = UDim2.new(1, 0, 0, 30)
            OptBtn.BackgroundColor3 = Color3.fromRGB(20, 20, 28)
            OptBtn.BorderSizePixel = 0
            OptBtn.Text = ""

            local OptLabel = Instance.new("TextLabel", OptBtn)
            OptLabel.Size = UDim2.new(0.7, 0, 1, 0)
            OptLabel.Position = UDim2.new(0, 20, 0, 0)
            OptLabel.BackgroundTransparency = 1
            OptLabel.Text = optName
            OptLabel.TextColor3 = targetTable[optName] and Theme.Accent or Theme.TextDim
            OptLabel.TextSize = 11
            OptLabel.Font = Enum.Font.Gotham
            OptLabel.TextXAlignment = Enum.TextXAlignment.Left

            local StatusIcon = Instance.new("TextLabel", OptBtn)
            StatusIcon.Size = UDim2.new(0, 30, 1, 0)
            StatusIcon.Position = UDim2.new(1, -40, 0, 0)
            StatusIcon.BackgroundTransparency = 1
            StatusIcon.Text = targetTable[optName] and "✓" or ""
            StatusIcon.TextColor3 = Theme.Accent
            StatusIcon.TextSize = 12
            StatusIcon.Font = Enum.Font.GothamBold

            OptBtn.MouseButton1Click:Connect(function()
                targetTable[optName] = not targetTable[optName]
                StatusIcon.Text = targetTable[optName] and "✓" or ""
                OptLabel.TextColor3 = targetTable[optName] and Theme.Accent or Theme.TextDim
            end)
        end
    end

    return RefreshOptions
end

