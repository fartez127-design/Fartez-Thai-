-- ================= [ FUNCTION: AUTO SELL LOGIC ] ================= --
local function ProcessAutoSell()
    pcall(function()
        local mainGui = player.PlayerGui:FindFirstChild("Main")
        if not mainGui then return end
        
        local scrollingFrame = mainGui:FindFirstChild("Pet_Main")
            and mainGui.Pet_Main:FindFirstChild("Pet")
            and mainGui.Pet_Main.Pet:FindFirstChild("zheng")
            and mainGui.Pet_Main.Pet.zheng:FindFirstChild("wuqi")
            and mainGui.Pet_Main.Pet.zheng.wuqi:FindFirstChild("Right")
            and mainGui.Pet_Main.Pet.zheng.wuqi.Right:FindFirstChild("ScrollingFrame")

        if not scrollingFrame then return end

        local deleteRE = ReplicatedStorage:WaitForChild("Remote"):WaitForChild("Pet_Server"):WaitForChild("DeleteRE")

        for _, item in ipairs(scrollingFrame:GetChildren()) do
            if not _G.AutoSellPets then break end

            local button = item:FindFirstChild("Button")
            local info = button and button:FindFirstChild("Info")
            local zi = info and info:FindFirstChild("zi")
            local nameObj = zi and zi:FindFirstChild("Name")

            if nameObj then
                local petName = tostring(nameObj.Text or nameObj.Value or "")
                
                -- ตรวจสอบว่าชื่อ Pet ตรงกับรายการที่ถูกเลือกให้ขายหรือไม่
                if _G.SellList[petName] then
                    local uuid = item.Name -- ดึงค่า UUID ของ Pet
                    print("กำลังขาย:", petName, "| UUID:", uuid)
                    deleteRE:FireServer(uuid)
                    task.wait(0.2)
                end
            end
        end
    end)
end

