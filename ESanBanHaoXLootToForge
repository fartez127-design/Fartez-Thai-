-- ================= [ AUTO UPGRADE LOGIC (STRICT BUFF LOCKING) ] ================= --

local function GetPetQuality(item)
    local isGolden = item:FindFirstChild("Golden") or item:FindFirstChild("Gold")
    local isDiamond = item:FindFirstChild("Diamond")
    local isRainbow = item:FindFirstChild("Rainbow")

    for _, desc in ipairs(item:GetDescendants()) do
        if desc:IsA("TextLabel") or desc:IsA("StringValue") then
            local text = tostring(desc.Text or desc.Value)
            if string.find(text, "Rainbow") then return "Rainbow" end
            if string.find(text, "Diamond") then return "Diamond" end
            if string.find(text, "Golden") or string.find(text, "Gold") then return "Golden" end
        end
    end

    if isRainbow then return "Rainbow" end
    if isDiamond then return "Diamond" end
    if isGolden then return "Golden" end

    return "Normal"
end

local function ProcessAutoUpgradePets()
    pcall(function()
        local scrollingFrame = player.PlayerGui.Main.Pet_Main.Pet.zheng.wuqi.Right.ScrollingFrame
        local upgradeRF = ReplicatedStorage:WaitForChild("Remote"):WaitForChild("Pet_Server"):WaitForChild("TryUpGradePetRF")

        local petGroups = {}

        local requiredQuality = "Normal"
        if _G.UpgradeBuff == "Diamond" then
            requiredQuality = "Golden"
        elseif _G.UpgradeBuff == "Rainbow" then
            requiredQuality = "Diamond"
        end

        for _, item in ipairs(scrollingFrame:GetChildren()) do
            if not _G.AutoUpgradePets then break end

            local button = item:FindFirstChild("Button")
            local info = button and button:FindFirstChild("Info")
            local zi = info and info:FindFirstChild("zi")
            local nameObj = zi and zi:FindFirstChild("Name")

            if nameObj then
                local petName
                if nameObj:IsA("TextLabel") or nameObj:IsA("TextButton") then
                    petName = nameObj.Text
                elseif nameObj:IsA("StringValue") then
                    petName = nameObj.Value
                end

                if petName and _G.UpgradeList[petName] then
                    local currentQuality = GetPetQuality(item)
                    
                    if currentQuality == requiredQuality then
                        if not petGroups[petName] then
                            petGroups[petName] = {}
                        end
                        table.insert(petGroups[petName], item.Name)
                    end
                end
            end
        end

        local targetAmount = tonumber(_G.UpgradeAmount) or 5

        for petName, uuids in pairs(petGroups) do
            if not _G.AutoUpgradePets then break end

            while #uuids >= targetAmount and _G.AutoUpgradePets do
                local payload = {}
                for i = 1, targetAmount do
                    local uuid = table.remove(uuids, 1)
                    if uuid then
                        payload[uuid] = true
                    end
                end

                pcall(function()
                    upgradeRF:InvokeServer(payload, _G.UpgradeBuff)
                end)
                
                task.wait(0.8)
            end
        end
    end)
end

