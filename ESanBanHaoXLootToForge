-- 1. ฟังก์ชั่น ปั้มเหรียญ
CreateToggle(MainTab, "ปั้มเหรียญ", false, function(Value)
    _G.AutoFarmCoins = Value
    if Value then
        task.spawn(function()
            local remoteFolder = ReplicatedStorage:WaitForChild("Remote", 10)
            local DS = remoteFolder and remoteFolder:WaitForChild("Dungeon_Server", 10)
            
            if not DS then return end

            while _G.AutoFarmCoins do
                pcall(function()
                    DS.TryClaimDailyDunTicRE:FireServer()
                    task.wait(0.2)
                    local entered = DS.TryIntoDungeonRF:InvokeServer(true, 50)
                    task.wait(0.2)
                    
                    local done = false
                    local rounds = 0
                    
                    for _ = 1, 5 do
                        task.spawn(function()
                            while not done and _G.AutoFarmCoins do
                                DS.StartRoundRE:FireServer(50)
                                local result = DS.CompleteRoundRF:InvokeServer(50)
                                if type(result) ~= "table" then
                                    done = true
                                    break
                                end
                                rounds += 1
                                task.wait(0.1)
                            end
                        end)
                    end
                    
                    repeat task.wait(0.5) until done or not _G.AutoFarmCoins
                end)
                task.wait(1)
            end
        end)
    end
end)

